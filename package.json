{
  "name": "money-bot",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "test": "tsx --test src/*.test.ts",
    "start": "FNOX_AGE_KEY_FILE=\"$HOME/.ssh/id_ed25519\" fnox exec -- tsx src/index.ts",
    "start:container": "tsx src/index.ts",
    "dev": "FNOX_AGE_KEY_FILE=\"$HOME/.ssh/id_ed25519\" fnox exec -- tsx watch src/index.ts",
    "deploy:commands": "FNOX_AGE_KEY_FILE=\"$HOME/.ssh/id_ed25519\" fnox exec -- tsx src/deploy-commands.ts",
    "deploy:commands:raw": "tsx src/deploy-commands.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "better-sqlite3": "^12.10.1",
    "discord.js": "14.26.5",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "node-gyp": "^13.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
